{
  "_comment": "yc-nexus-scout configuration. Machine-read by scripts/ycscout.py and by the skill. Keep IDs exact. Edit lists freely.",
  "version": 1,
  "batches": {
    "_comment": "YC runs four batches a year: W (Winter), X (Spring), S (Summer), F (Fall). Dates below are month-day defaults; put exact dates in overrides when YC announces them. A batch is tracked while it is forming (from forming_lead_days before start), in session, or within post_demo_days after demo day.",
    "defaults": {
      "W": {
        "season": "Winter",
        "slug_season": "winter",
        "start": "01-05",
        "demo": "03-25"
      },
      "X": {
        "season": "Spring",
        "slug_season": "spring",
        "start": "04-06",
        "demo": "06-17"
      },
      "S": {
        "season": "Summer",
        "slug_season": "summer",
        "start": "06-22",
        "demo": "09-09"
      },
      "F": {
        "season": "Fall",
        "slug_season": "fall",
        "start": "10-01",
        "demo": "12-02"
      }
    },
    "forming_lead_days": 90,
    "post_demo_days": 90,
    "probe_ahead": 2,
    "overrides": {
      "S26": {
        "demo": "2026-09-10"
      },
      "F26": {
        "start": "2026-10-01",
        "demo": "2026-12-02"
      }
    }
  },
